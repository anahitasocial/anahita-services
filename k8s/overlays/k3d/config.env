# A k3d cluster on this machine, reached at http://api.localhost:8088.
ENV=dev
# On, as on a live site: with ENV=dev it would otherwise default to off.
GRPC_TLS=on
DOMAIN_NAME=localhost
SITE_NAME=Anahita
SYSTEM_EMAIL=no-reply@localhost
SUPPORT_EMAIL=support@localhost
OAUTH_ISSUER=http://auth.localhost:8088
WEB_ORIGIN=http://localhost:3000
REGISTRATION_MODE=open

# In dev every message goes to this address, and mail-grpc-service will not
# start without it. The mailpit component catches it all.
DEVELOPER_EMAIL=developer@localhost
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false

# The Garage in the cluster.
STORAGE_ENDPOINT=http://garage:3900
STORAGE_PUBLIC_ENDPOINT=http://files.localhost:8088
STORAGE_REGION=garage
STORAGE_BUCKET=anahita
STORAGE_PATH_STYLE=true
