# Copy to secrets.env, which git ignores, and replace every CHANGE_ME.
# Generate the two 32-character keys with: openssl rand -hex 16

# The database account. DSN repeats the user and password, for the services;
# the three MYSQL_ entries are for the migration job and the MySQL component.
MYSQL_USER=anahita
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
DSN=anahita:CHANGE_ME@(mysql:3306)/anahita?parseTime=true

# The event bus account. AMQP_ADDR repeats it.
RABBITMQ_USER=anahita
RABBITMQ_PASSWORD=CHANGE_ME
AMQP_ADDR=amqp://anahita:CHANGE_ME@rabbitmq:5672

# Empty for the Redis component without a password.
REDIS_PASSWORD=

# Signs session cookies. Exactly 32 characters.
SECURE_COOKIE_KEY=CHANGE_ME
# Seals two-factor secrets and the token signing key. Exactly 32 characters.
# Keep a copy somewhere safe: without it nobody can sign in.
CRYPT_LOCAL_KEY=CHANGE_ME

# Object storage credentials.
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME

# Mail. Leave both empty for a relay that needs no sign-in.
SMTP_USER=
SMTP_PASSWORD=
