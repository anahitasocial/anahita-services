# Non-secret settings for this site. docs/configuration.md describes each one;
# anything not listed here keeps its default. Passwords and keys go in
# secrets.env.

# Site identity. The web app is served at https://<DOMAIN_NAME>, and
# auth-service at https://auth.<DOMAIN_NAME>.
DOMAIN_NAME=example.org
SITE_NAME=Example
SYSTEM_EMAIL=no-reply@example.org
SUPPORT_EMAIL=support@example.org

# The address tokens are issued under, and the web app's origin, the one
# origin the gateway lets call the API with the session cookie.
OAUTH_ISSUER=https://auth.example.org
WEB_ORIGIN=https://example.org

# How people get in: open, approval, invite or closed.
REGISTRATION_MODE=closed

# The first super administrator, created at first start. The link to set a
# password is mailed, and written to auth-service's log.
SUPER_ADMIN_EMAIL=admin@example.org

# Object storage: any S3-compatible store. The bucket must exist and be
# private. STORAGE_PUBLIC_ENDPOINT is only needed when browsers reach the
# store at a different address than the cluster does.
STORAGE_ENDPOINT=https://s3.example-provider.net
STORAGE_REGION=region-1
STORAGE_BUCKET=example-anahita
STORAGE_PATH_STYLE=false

# Outgoing mail.
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURE=false

# Sent to the public geocoders, whose usage policy asks for a contact.
GEOCODER_CONTACT=admin@example.org
