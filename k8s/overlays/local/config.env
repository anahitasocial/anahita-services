# A local cluster, reached at http://localhost through `minikube tunnel`.
ENV=dev
# On, as on a live site: with ENV=dev it would otherwise default to off.
GRPC_TLS=on
DOMAIN_NAME=localhost
SITE_NAME=Anahita
SYSTEM_EMAIL=no-reply@localhost
SUPPORT_EMAIL=support@localhost
OAUTH_ISSUER=http://localhost
WEB_ORIGIN=http://localhost:3000
REGISTRATION_MODE=open

# In dev every message goes to this address, and mail-grpc-service will not
# start without it. Point SMTP_HOST at a mail sink such as mailpit.
DEVELOPER_EMAIL=developer@localhost
SMTP_HOST=host.minikube.internal
SMTP_PORT=1025
SMTP_SECURE=false

# The Garage that docker-compose runs on this machine (make storage_init).
STORAGE_ENDPOINT=http://host.minikube.internal:3900
STORAGE_PUBLIC_ENDPOINT=http://localhost:3900
STORAGE_REGION=garage
STORAGE_BUCKET=anahita
STORAGE_PATH_STYLE=true
