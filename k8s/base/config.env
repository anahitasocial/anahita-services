# Settings that are the same on every cluster: how the services find each
# other. An overlay's config.env is merged over this one and may replace any
# of them, for example REDIS_ADDR and MYSQL_HOST when those are managed
# services outside the cluster.
ENV=prod
FILE_SERVICE_ADDR=file-grpc-service:50051
GRAPH_SERVICE_ADDR=graph-grpc-service:50051
MAIL_SERVICE_ADDR=mail-grpc-service:50051
OAUTH_JWKS_URL=http://auth-service/.well-known/jwks.json
REDIS_ADDR=redis:6379
MYSQL_HOST=mysql
MYSQL_DATABASE=anahita
