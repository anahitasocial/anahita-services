{
    "clients": [
        {
            "client_id": "anahita-web",
            "name": "Anahita Web App",
            "redirect_uris": [
                "http://localhost:3000/oauth/callback"
            ],
            "grant_types": [
                "authorization_code",
                "refresh_token"
            ],
            "scopes": [
                "openid",
                "profile",
                "email",
                "offline_access",
                "people:read",
                "people:write",
                "notifications:read",
                "notifications:write",
                "authlogs:read",
                "authlogs:write",
                "oauth_clients:read",
                "oauth_clients:write",
                "webauthn:read",
                "webauthn:write"
            ],
            "token_expiry": 900,
            "confidential": false,
            "skip_consent": true,
            "first_party": true,
            "active": true
        }
    ]
}
