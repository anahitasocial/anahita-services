{
  "components": {
    "schemas": {
      "ActorBrief": {
        "description": "ActorBrief is an actor named beside something else: who invited, who was invited, what they were invited to. Enough to show a picture and a name and to lead to the profile, and nothing of the profile itself.",
        "properties": {
          "alias": {
            "type": "string"
          },
          "avatar_urls": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Image"
            },
            "type": "object"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "type"
        ],
        "type": "object"
      },
      "Author": {
        "properties": {
          "alias": {
            "type": "string"
          },
          "avatar_urls": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Image"
            },
            "type": "object"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "Editor": {
        "properties": {
          "alias": {
            "type": "string"
          },
          "avatar_urls": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Image"
            },
            "type": "object"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "Event": {
        "description": "Event is what only an event has, on the actor it is.",
        "properties": {
          "address": {
            "$ref": "#/components/schemas/EventAddress",
            "description": "Where it is held, when it is somewhere. Sent to the same people as the address to join online, and for the same reason: it may be somebody's home. HasAddress says there is one all the same."
          },
          "cancelled_at": {
            "description": "Set when it was called off.",
            "format": "date-time",
            "type": "string"
          },
          "capacity": {
            "description": "How many may be going. 0 for no limit.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "ends_at": {
            "format": "date-time",
            "type": "string"
          },
          "going_count": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "has_address": {
            "type": "boolean"
          },
          "has_online_url": {
            "type": "boolean"
          },
          "host": {
            "$ref": "#/components/schemas/ActorBrief",
            "description": "The group hosting it, when there is one the viewer may see."
          },
          "is_full": {
            "description": "Every place is taken. Maybe is still open.",
            "type": "boolean"
          },
          "maybe_count": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "online_url": {
            "description": "Where to join online. Sent only to whoever is going and whoever looks after the event; HasOnlineURL says there is one all the same.",
            "type": "string"
          },
          "open_to_host_followers": {
            "description": "Whether everybody who follows the host may see that it is on and answer it.",
            "type": "boolean"
          },
          "starts_at": {
            "format": "date-time",
            "type": "string"
          },
          "state": {
            "description": "upcoming, happening, past or cancelled, as of when it was sent.",
            "type": "string"
          },
          "timezone_name": {
            "description": "The zone the times were given in, as IANA names it. The times themselves are UTC.",
            "type": "string"
          },
          "viewer_rsvp": {
            "description": "What the viewer has answered: going, maybe, or left out.",
            "type": "string"
          }
        },
        "required": [
          "starts_at",
          "ends_at",
          "timezone_name",
          "capacity",
          "has_online_url",
          "has_address",
          "going_count",
          "maybe_count",
          "is_full",
          "state"
        ],
        "type": "object"
      },
      "EventAddress": {
        "description": "EventAddress is where an event is held, as it was typed: the node's own address fields. It is not a place on the site's map. Nobody else can find it, tag it or search for it.",
        "properties": {
          "city": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "latitude": {
            "description": "Where that is on a map, when whoever made the event asked for one and the address was found. Left out otherwise.",
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "postal_code": {
            "type": "string"
          },
          "state_province": {
            "type": "string"
          },
          "street": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "FeedBrief": {
        "description": "FeedBrief is what a custom feed is beyond its name and its owner, for where one is listed among other things, as in search results: its picture and what it shows.",
        "properties": {
          "definition": {},
          "icon": {
            "type": "string"
          }
        },
        "required": [
          "icon",
          "definition"
        ],
        "type": "object"
      },
