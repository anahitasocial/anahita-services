      },
      "LinkPreview": {
        "description": "LinkPreview is the card a note carries for a link in it: what the page was called and was about when the note was written.",
        "properties": {
          "description": {
            "type": "string"
          },
          "image": {
            "description": "Where its picture is read from, on this installation: a path under the API. Never the other site's own address for it.",
            "type": "string"
          },
          "site_name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url",
          "title"
        ],
        "type": "object"
      },
      "MediaRemoved": {
        "description": "MediaRemoved is what a post from another server says of pictures that are no longer stored here: how many there were, what each showed, and whether they can still be had from where they came from.",
        "properties": {
          "alts": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "count": {
            "format": "int64",
            "type": "integer"
          },
          "gone": {
            "type": "boolean"
          }
        },
        "required": [
          "count",
          "alts"
        ],
        "type": "object"
      },
      "NodeAuthorized": {
        "properties": {
          "add_follower": {
            "type": "boolean"
          },
          "administration": {
            "type": "boolean"
          },
          "audiences": {
            "description": "On a person or group: who a new post there may be shown to. On a post: who it may be changed to be shown to, for somebody who may edit it. Widest first; left out otherwise.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "block_from_owner": {
            "description": "On a post or a reply in a group or an event: whether the viewer may block its writer from there, as the group.",
            "type": "boolean"
          },
          "comment": {
            "description": "Left out when not worked out for this response, so the web app can tell \"no\" from \"not answered here\" and keep its fallback for the latter. See entities.AnahitaNodeAuthorized.\n\nComposers is left out when empty too: every person and group response works it out, so there a missing list means none.",
            "type": "boolean"
          },
          "composers": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "delete": {
            "type": "boolean"
          },
          "download": {
            "description": "On a post that holds a file: whether the viewer may download it.",
            "type": "boolean"
          },
          "edit": {
            "type": "boolean"
          },
          "hide": {
            "description": "On a reply: whether the viewer may hide it from its thread.",
            "type": "boolean"
          },
          "invite": {
            "description": "Whether the viewer may invite people to follow this actor.",
            "type": "boolean"
          },
          "like": {
            "type": "boolean"
          },
          "pin": {
            "description": "On a post: whether the viewer may pin it to the profile it is on.",
            "type": "boolean"
          },
          "quote": {
            "description": "On a post: whether the viewer may quote it.",
            "type": "boolean"
          }
        },
        "required": [
          "edit",
          "delete",
          "administration"
        ],
        "type": "object"
      },
