  "info": {
    "description": "The hashtags written in posts, and the posts each one is in.",
    "license": {
      "identifier": "Apache-2.0",
      "name": "Apache 2.0"
    },
    "title": "Hashtags",
    "version": "dev"
  },
  "openapi": "3.1.0",
  "paths": {
    "/hashtags/": {
      "get": {
        "description": "Who may call it: anyone, signed in or not.",
        "operationId": "getHashtags",
        "parameters": [
          {
            "description": "How many to pass over.",
            "in": "query",
            "name": "start",
            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "The most to send.",
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 20,
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "The order: in the most posts first, or the latest first.",
            "in": "query",
            "name": "sort",
            "schema": {
              "default": "recent",
              "enum": [
                "popular",
                "recent"
              ],
              "maxLength": 10,
              "type": "string"
            }
          },
          {
            "description": "Which way the order runs.",
            "in": "query",
            "name": "dir",
            "schema": {
              "default": "desc",
              "enum": [
                "asc",
                "desc"
              ],
              "maxLength": 4,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "description": "What is on this page.",
                      "items": {
