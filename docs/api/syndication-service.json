{
  "components": {
    "schemas": {
      "syndication.ChannelFeed": {
        "description": "ChannelFeed is a channel's feed as its admins see it.",
        "properties": {
          "feed_url": {
            "description": "The feed read, and the site it is of.",
            "type": "string"
          },
          "read_at": {
            "description": "When it was last read, if it has been.",
            "format": "date-time",
            "type": "string"
          },
          "site_url": {
            "type": "string"
          },
          "state": {
            "description": "`active`, or `paused`: its domain's proof gone for a week, or the channel switched off.",
            "type": "string"
          }
        },
        "required": [
          "feed_url",
          "site_url",
          "state"
        ],
        "type": "object"
      },
      "syndication.Checked": {
        "description": "Checked says whether the token was found.",
        "properties": {
          "method": {
            "description": "`dns` or `file`: where it was found.",
            "type": "string"
          },
          "proved": {
            "type": "boolean"
          }
        },
        "required": [
          "proved"
        ],
        "type": "object"
      },
      "syndication.Connection": {
        "description": "Connection is a channel being connected: its feed, and the token with both places it may be put.",
        "properties": {
          "domain": {
            "description": "The domain to prove, and the host the file is read from.",
            "type": "string"
          },
          "feed_description": {
            "type": "string"
          },
          "feed_title": {
            "type": "string"
          },
          "feed_url": {
            "type": "string"
          },
          "file_url": {
            "description": "Or a file at this address, holding the token.",
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "id": {
            "description": "The connection's id, for checking the proof and making the channel.",
            "format": "int64",
            "type": "integer"
          },
          "record_name": {
            "description": "A TXT record of this name, holding the token.",
            "type": "string"
          },
          "site_url": {
            "description": "The site and its feed, as found.",
            "type": "string"
          },
          "token": {
            "description": "What to put in either place.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "domain",
          "host",
          "site_url",
          "feed_url",
          "token",
          "record_name",
          "file_url"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "description": "An access token from auth-service (docs/oauth.md).",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "A channel's feed: a website's feed found, its domain proved, and the feed connected to a channel its admins look after, whose notes are then the feed's items (channels.md). Who may connect one is CHANNELS_FROM, administrators unless the installation says otherwise.",
    "license": {
      "identifier": "AGPL-3.0-only",
      "name": "GNU Affero General Public License v3.0 only"
    },
    "title": "Channels",
    "version": "dev"
  },
  "openapi": "3.1.0",
  "paths": {
    "/channels/_connect": {
      "post": {
        "description": "The site's feed is found: the address itself, or the feed the page names with `<link rel=\"alternate\">`. It must be on the site's domain. The answer is the token, to be put in a TXT record or a file.\n\nWho may call it: somebody signed in.",
        "operationId": "postChannelsConnect",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "site_url": {
                    "description": "The site's address, `example.com` or `https://example.com/blog/`, or its feed's.",
                    "maxLength": 2000,
                    "type": "string"
                  }
                },
                "required": [
                  "site_url"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/syndication.Connection"
                }
              }
            },
            "description": "Created"
          },
          "400": {
            "description": "`not_a_domain`, `no_feed`, `unreadable`, `feed_not_on_domain` or `private_feed` (behind a login, or a secret in its address: a channel is public), as `error`"
          },
          "401": {
            "description": "the viewer is not signed in"
          },
          "403": {
            "description": "the viewer may not connect a channel: see CHANNELS_FROM"
          },
          "409": {
            "description": "`feed_taken`: the feed already has a Channel"
          },
          "429": {
            "description": "the viewer has begun too many lately"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Begin connecting a channel",
        "tags": [
          "syndication-service"
        ],
        "x-handler": "syndication/cmd/api/handlers.(*connectHandler).Start",
        "x-viewer": "signed_in"
      }
    },
    "/channels/_connect/feeds/{channel_id}": {
      "delete": {
        "description": "The feed is read no more. The notes it made stay, as their site wrote them; connecting the same feed again posts none of them twice.\n\nWho may call it: somebody signed in.",
        "operationId": "deleteChannelsConnectFeedsByChannelId",
        "parameters": [
          {
            "description": "The channel's id.",
            "in": "path",
            "name": "channel_id",
            "required": true,
            "schema": {
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "it is disconnected"
          },
          "400": {
            "description": "the request is not well formed, or a value in it is not one it may be"
          },
          "401": {
            "description": "the viewer is not signed in"
          },
          "403": {
            "description": "the viewer is not one of the channel's admins"
          },
          "404": {
            "description": "there is no such channel, or it has no feed"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Disconnect a channel's feed",
        "tags": [
          "syndication-service"
        ],
        "x-handler": "syndication/cmd/api/handlers.(*connectHandler).DisconnectFeed",
        "x-viewer": "signed_in"
      },
      "get": {
        "description": "The feed a channel reads, for its admins and the site's administrators.\n\nWho may call it: somebody signed in.",
        "operationId": "getChannelsConnectFeedsByChannelId",
        "parameters": [
          {
            "description": "The channel's id.",
            "in": "path",
            "name": "channel_id",
            "required": true,
            "schema": {
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/syndication.ChannelFeed"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "description": "the request is not well formed, or a value in it is not one it may be"
          },
          "401": {
            "description": "the viewer is not signed in"
          },
          "403": {
            "description": "the viewer is not one of the channel's admins"
          },
          "404": {
            "description": "there is no such channel, or it has no feed"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "A channel's feed",
        "tags": [
          "syndication-service"
        ],
        "x-handler": "syndication/cmd/api/handlers.(*connectHandler).ShowFeed",
        "x-viewer": "signed_in"
      },
      "put": {
        "description": "Once the site's domain is proved (the two calls above). The channel's admins connect it; whoever proved the domain must be the one connecting. Its feed's ten newest items are posted, the rest marked seen, and what is published afterwards is posted as it comes. Where the channel names no website, the proved site becomes its website.\n\nWho may call it: somebody signed in.",
        "operationId": "putChannelsConnectFeedsByChannelId",
        "parameters": [
          {
            "description": "The channel's id.",
            "in": "path",
            "name": "channel_id",
            "required": true,
            "schema": {
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "connection_id": {
                    "description": "The connection begun and proved, as starting it answered.",
                    "format": "int64",
                    "minimum": 1,
                    "type": "integer"
                  },
                  "feed_url": {
                    "description": "The feed, as starting the connection found it.",
                    "maxLength": 2000,
                    "type": "string"
                  }
                },
                "required": [
                  "connection_id",
                  "feed_url"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/syndication.ChannelFeed"
                }
              }
            },
            "description": "Created"
          },
          "400": {
            "description": "`no_feed`, `unreadable`, `feed_not_on_domain` or `private_feed`, as `error`"
          },
          "401": {
            "description": "the viewer is not signed in"
          },
          "403": {
            "description": "the viewer may not connect a channel: see CHANNELS_FROM"
          },
          "404": {
            "description": "there is no such channel, or no such connection begun by the viewer"
          },
          "409": {
            "description": "`not_proved`, `feed_taken` or `has_feed` (one feed a channel), as `error`"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Connect a channel's feed",
        "tags": [
          "syndication-service"
        ],
        "x-handler": "syndication/cmd/api/handlers.(*connectHandler).ConnectFeed",
        "x-viewer": "signed_in"
      }
    },
    "/channels/_connect/{id}/check": {
      "post": {
        "description": "In the TXT record at `_anahita.<domain>`, then in `https://<host>/.well-known/anahita-verification.txt`. Asked as often as the one connecting likes.\n\nWho may call it: somebody signed in.",
        "operationId": "postChannelsConnectByIdCheck",
        "parameters": [
          {
            "description": "The connection's id, as starting it answered.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/syndication.Checked"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "description": "the request is not well formed, or a value in it is not one it may be"
          },
          "401": {
            "description": "the viewer is not signed in"
          },
          "403": {
            "description": "the viewer may not connect a channel: see CHANNELS_FROM"
          },
          "404": {
            "description": "there is no such connection begun by the viewer"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Look for the token",
        "tags": [
          "syndication-service"
        ],
        "x-handler": "syndication/cmd/api/handlers.(*connectHandler).Check",
        "x-viewer": "signed_in"
      }
    },
    "/channels/_websub/{id}/{signature}": {
      "get": {
        "description": "WebSub: the hub a Channel's feed names asks whether its subscription was asked for here, and is answered with its challenge.\n\nWho may call it: anyone, signed in or not.",
        "operationId": "getChannelsWebsubByIdBySignature",
        "parameters": [
          {
            "description": "The channel's id, and the signature that came with it.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "signature",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "What the hub checks: `subscribe`, `unsubscribe`, or `denied`.",
            "in": "query",
            "name": "hub.mode",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "What to answer with, to show the subscription was asked for here.",
            "in": "query",
            "name": "hub.challenge",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "How long, in seconds, the hub will call back.",
            "in": "query",
            "name": "hub.lease_seconds",
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "the challenge, as plain text"
          },
          "400": {
            "description": "it is not a check this answers"
          },
          "404": {
            "description": "there is no such Channel, or no subscription was asked for"
          }
        },
        "security": [
          {},
          {
            "bearer": []
          }
        ],
        "summary": "A hub checks a subscription",
        "tags": [
          "syndication-service"
        ],
        "x-handler": "syndication/cmd/api/handlers.(*websubHandler).Verify",
        "x-viewer": "anyone"
      },
      "post": {
        "description": "The Channel's feed is read from its site at once, at most once a minute; what the hub sends is not read.\n\nWho may call it: anyone, signed in or not.",
        "operationId": "postChannelsWebsubByIdBySignature",
        "parameters": [
          {
            "description": "The channel's id, and the signature that came with it.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "signature",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "What the hub checks: `subscribe`, `unsubscribe`, or `denied`.",
            "in": "query",
            "name": "hub.mode",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "What to answer with, to show the subscription was asked for here.",
            "in": "query",
            "name": "hub.challenge",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "How long, in seconds, the hub will call back.",
            "in": "query",
            "name": "hub.lease_seconds",
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "it will be read"
          },
          "404": {
            "description": "there is no such Channel, or no subscription was asked for"
          }
        },
        "security": [
          {},
          {
            "bearer": []
          }
        ],
        "summary": "A hub says a feed changed",
        "tags": [
          "syndication-service"
        ],
        "x-handler": "syndication/cmd/api/handlers.(*websubHandler).Notify",
        "x-viewer": "anyone"
      }
    }
  },
  "servers": [
    {
      "description": "An installation's API",
      "url": "https://{host}",
      "variables": {
        "host": {
          "default": "api.example.org",
          "description": "Where the installation's API is"
        }
      }
    }
  ],
  "tags": [
    {
      "description": "Channels",
      "name": "syndication-service"
    }
  ]
}
