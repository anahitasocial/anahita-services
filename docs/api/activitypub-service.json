{
  "components": {
    "schemas": {
      "DomainBlock": {
        "description": "DomainBlock is a server this installation will have nothing to do with.",
        "properties": {
          "created_at": {
            "description": "When.",
            "format": "date-time",
            "type": "string"
          },
          "created_by": {
            "description": "The super administrator who refused it.",
            "format": "int64",
            "type": "integer"
          },
          "domain": {
            "description": "The server's name.",
            "type": "string"
          },
          "reason": {
            "description": "Why it is refused.",
            "type": "string"
          }
        },
        "required": [
          "domain",
          "reason",
          "created_by",
          "created_at"
        ],
        "type": "object"
      },
      "Pagination": {
        "description": "Pagination is where a page is among everything there is to list.",
        "properties": {
          "limit": {
            "description": "The most a page holds: what was asked for as `limit`.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "offset": {
            "description": "How many come before this page: what was asked for as `start`.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "total": {
            "description": "How many there are in all.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "offset",
          "limit",
          "total"
        ],
        "type": "object"
      },
      "PicturesRestored": {
        "description": "PicturesRestored says the pictures of a post from another server are here again.",
        "properties": {
          "restored": {
            "description": "How many were copied.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "restored"
        ],
        "type": "object"
      },
      "Refusal": {
        "description": "Refusal is why a request was refused, where the answer says: most refusals have no body, and some send this.",
        "properties": {
          "description": {
            "description": "The same in words, for whoever is building a client.",
            "type": "string"
          },
          "error": {
            "description": "Why, as a code a client can tell apart: `language_invalid`, `quote_not_allowed` and so on. Each route lists its own.",
            "type": "string"
          },
          "reason": {
            "description": "What lies behind it, where one code has several causes: why a post may not be quoted, for one.",
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "activitypub.Actor": {
        "description": "Actor is somebody, as they are described to another server.",
        "properties": {
          "@context": {},
          "discoverable": {
            "type": "boolean"
          },
          "endpoints": {
            "$ref": "#/components/schemas/activitypub.Endpoints"
          },
          "followers": {
            "type": "string"
          },
          "following": {
            "type": "string"
          },
          "icon": {
            "$ref": "#/components/schemas/activitypub.Image"
          },
          "id": {
            "type": "string"
          },
          "image": {
            "$ref": "#/components/schemas/activitypub.Image"
          },
          "inbox": {
            "type": "string"
          },
          "manuallyApprovesFollowers": {
            "description": "Whether a follow waits to be approved.",
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "outbox": {
            "type": "string"
          },
          "preferredUsername": {
            "type": "string"
          },
          "publicKey": {
            "$ref": "#/components/schemas/activitypub.PublicKey"
          },
          "published": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "preferredUsername",
          "inbox",
          "outbox",
          "followers",
          "following",
          "publicKey",
          "manuallyApprovesFollowers",
          "discoverable"
        ],
        "type": "object"
      },
      "activitypub.Collection": {
        "description": "Collection is a list said only by how long it is: who follows somebody is theirs to know, and how many is all that is told.",
        "properties": {
          "@context": {},
          "id": {
            "type": "string"
          },
          "totalItems": {
            "format": "int64",
            "type": "integer"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "@context",
          "id",
          "type",
          "totalItems"
        ],
        "type": "object"
      },
      "activitypub.Endpoints": {
        "properties": {
          "sharedInbox": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "activitypub.Image": {
        "properties": {
          "mediaType": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "url"
        ],
        "type": "object"
      },
      "activitypub.JRD": {
        "description": "JRD is a WebFinger answer: who a handle is, and where they are.",
        "properties": {
          "aliases": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "links": {
            "items": {
              "$ref": "#/components/schemas/activitypub.JRDLink"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "subject": {
            "type": "string"
          }
        },
        "required": [
          "subject",
          "links"
        ],
        "type": "object"
      },
      "activitypub.JRDLink": {
        "properties": {
          "href": {
            "type": "string"
          },
          "rel": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "rel"
        ],
        "type": "object"
      },
      "activitypub.Note": {
        "description": "Note is a post, as it is sent to and read from another server.",
        "properties": {
          "@context": {},
          "attachment": {
            "description": "The pictures of a photo post, or the video of a video post.",
            "items": {
              "$ref": "#/components/schemas/activitypub.SentPicture"
            },
            "type": "array"
          },
          "attributedTo": {
            "type": "string"
          },
          "cc": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "content": {
            "type": "string"
          },
          "contentMap": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "id": {
            "type": "string"
          },
          "inReplyTo": {
            "description": "What it answers, by the address that has between servers.",
            "type": "string"
          },
          "published": {
            "type": "string"
          },
          "tag": {
            "items": {
              "$ref": "#/components/schemas/activitypub.Tag"
            },
            "type": "array"
          },
          "to": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "type": {
            "type": "string"
          },
          "updated": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "attributedTo",
          "content",
          "to",
          "cc"
        ],
        "type": "object"
      },
      "activitypub.PublicKey": {
        "properties": {
          "id": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "publicKeyPem": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "owner",
          "publicKeyPem"
        ],
        "type": "object"
      },
      "activitypub.RemotePerson": {
        "description": "RemotePerson is somebody on another server, as the web app is told.",
        "properties": {
          "alias": {
            "description": "Their handle: alice@mastodon.example.",
            "type": "string"
          },
          "body": {
            "description": "What they say of themselves.",
            "type": "string"
          },
          "id": {
            "description": "Their id here.",
            "format": "int64",
            "type": "integer"
          },
          "locked": {
            "description": "Whether a follow of theirs waits to be approved.",
            "type": "boolean"
          },
          "name": {
            "description": "Their name.",
            "type": "string"
          },
          "origin_domain": {
            "type": "string"
          },
          "type": {
            "description": "Always the type of a person on the fediverse.",
            "type": "string"
          },
          "uri": {
            "description": "Their address between servers, and the server it is on.",
            "type": "string"
          },
          "url": {
            "description": "Their page on their own server.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "name",
          "alias",
          "body",
          "uri",
          "origin_domain",
          "url",
          "locked"
        ],
        "type": "object"
      },
      "activitypub.SentIcon": {
        "description": "SentIcon is a still that stands for a video.",
        "properties": {
          "mediaType": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "mediaType",
          "url"
        ],
        "type": "object"
      },
      "activitypub.SentPicture": {
        "description": "SentPicture is one picture of a post, as it is sent: where to fetch it, what it is, how big, and what its author said it shows.",
        "properties": {
          "height": {
            "format": "int64",
            "type": "integer"
          },
          "icon": {
            "$ref": "#/components/schemas/activitypub.SentIcon",
            "description": "A video's poster, which Mastodon shows before it plays."
          },
          "mediaType": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "width": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "type",
          "mediaType",
          "url"
        ],
        "type": "object"
      },
      "activitypub.Settings": {
        "description": "Settings is what a person is shown about being on the fediverse.",
        "properties": {
          "actor": {
            "description": "Where those servers find them.",
            "type": "string"
          },
          "available": {
            "description": "Whether they could be, and why not when they could not.",
            "type": "boolean"
          },
          "enabled": {
            "description": "Whether they are.",
            "type": "boolean"
          },
          "handle": {
            "description": "What they are, or would be, called from other servers, and where those servers find them.",
            "type": "string"
          },
          "reason": {
            "description": "Why not: `site_private`, `site_unreachable` or `profile_not_public`.",
            "type": "string"
          }
        },
        "required": [
          "available",
          "enabled"
        ],
        "type": "object"
      },
      "activitypub.Tag": {
        "description": "Tag names somebody or a hashtag that a post mentions, beside its text.",
        "properties": {
          "href": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "href",
          "name"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "description": "An access token from auth-service (docs/oauth.md).",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "This installation on the fediverse, by ActivityPub: what other servers ask of it and send to it, a person's choice to be on it, finding somebody elsewhere, and the servers it refuses (federation.md). Optional: an installation may not run it.",
    "license": {
      "identifier": "Apache-2.0",
      "name": "Apache 2.0"
    },
    "title": "The fediverse",
    "version": "dev"
  },
  "openapi": "3.1.0",
  "paths": {
    "/.well-known/host-meta": {
      "get": {
        "description": "An XRD document (RFC 6415), for servers that look for WebFinger this way.\n\nWho may call it: anyone, signed in or not.",
        "operationId": "getWellKnownHostMeta",
        "responses": {
          "200": {
            "content": {
              "application/xrd+xml": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "the XRD document"
          }
        },
        "security": [
          {},
          {
            "bearer": []
          }
        ],
        "summary": "Where WebFinger is",
        "tags": [
          "activitypub-service"
        ],
        "x-handler": "activitypub/cmd/api/handlers.(*Handlers).HostMeta",
        "x-viewer": "anyone"
      }
    },
    "/.well-known/webfinger": {
      "get": {
        "description": "WebFinger (RFC 7033): where another server finds somebody here by their handle.\n\nWho may call it: anyone, signed in or not.",
        "operationId": "getWellKnownWebfinger",
        "parameters": [
          {
            "description": "`acct:ana@example.org`, or the address of somebody's actor.",
            "in": "query",
            "name": "resource",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/jrd+json": {
                "schema": {
                  "$ref": "#/components/schemas/activitypub.JRD"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "description": "no resource, or not one that is asked about"
          },
          "404": {
            "description": "nobody here by that name is on the fediverse"
          }
        },
        "security": [
          {},
          {
            "bearer": []
          }
        ],
        "summary": "Who an account is",
        "tags": [
          "activitypub-service"
        ],
        "x-handler": "activitypub/cmd/api/handlers.(*Handlers).WebFinger",
        "x-viewer": "anyone"
      }
    },
    "/activitypub/blocks": {
      "get": {
        "description": "Who may call it: a super administrator.",
        "operationId": "getActivitypubBlocks",
        "parameters": [
          {
            "description": "Words the name or the reason holds.",
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "How many to pass over.",
            "in": "query",
            "name": "start",
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "The most to send: 50 unless asked, 200 at most.",
            "in": "query",
            "name": "limit",
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "description": "What is on this page.",
                      "items": {
                        "$ref": "#/components/schemas/DomainBlock"
                      },
                      "type": [
                        "array",
                        "null"
                      ]
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination",
                      "description": "Where this page is among everything there is."
                    }
                  },
                  "required": [
                    "data",
                    "pagination"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "description": "no token, or one that has expired"
          },
          "403": {
            "description": "the viewer may not do this"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "The servers refused",
        "tags": [
          "activitypub-service"
        ],
        "x-handler": "activitypub/cmd/api/handlers.(*Handlers).BrowseBlocks",
        "x-viewer": "super_admin"
      },
      "post": {
        "description": "Nothing from it is taken, and nothing is sent to it.\n\nWho may call it: a super administrator.",
        "operationId": "postActivitypubBlocks",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "domain": {
                    "description": "The server's name, or an address or a handle on it.",
                    "type": "string"
                  },
                  "reason": {
                    "description": "Why it is refused.",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DomainBlock"
                }
              }
            },
            "description": "Created"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            },
            "description": "`domain_required`: the request names no server; `domain_unreadable`: it is not a server's name; `domain_is_here`: it is this installation"
          },
          "401": {
            "description": "no token, or one that has expired"
          },
          "403": {
            "description": "the viewer may not do this"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Refuse a server, or change why",
        "tags": [
          "activitypub-service"
        ],
        "x-handler": "activitypub/cmd/api/handlers.(*Handlers).AddBlock",
        "x-viewer": "super_admin"
      }
    },
    "/activitypub/blocks/{domain}": {
      "delete": {
        "description": "Who may call it: a super administrator.",
        "operationId": "deleteActivitypubBlocksByDomain",
        "parameters": [
          {
            "description": "Its name: `spam.example`.",
            "in": "path",
            "name": "domain",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "done"
          },
          "401": {
            "description": "no token, or one that has expired"
          },
          "403": {
            "description": "the viewer may not do this"
          },
          "404": {
            "description": "it is not refused"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Stop refusing a server",
        "tags": [
          "activitypub-service"
        ],
        "x-handler": "activitypub/cmd/api/handlers.(*Handlers).DeleteBlock",
        "x-viewer": "super_admin"
      }
    },
    "/activitypub/lookup": {
      "get": {
        "description": "They are kept here, so that they can be followed as anybody is. Thirty lookups in ten minutes.\n\nWho may call it: somebody signed in.",
        "operationId": "getActivitypubLookup",
        "parameters": [
          {
            "description": "Their handle (`@alice@mastodon.example`) or the address of their profile there.",
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/activitypub.RemotePerson"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            },
            "description": "`lookup_unreadable`"
          },
          "401": {
            "description": "no token, or one that has expired"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            },
            "description": "`lookup_not_found`, `lookup_is_here`, `lookup_not_a_person` or `lookup_refused`"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            },
            "description": "the installation is not on the fediverse: `site_private` or `site_unreachable`"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            },
            "description": "`too_many_lookups`"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            },
            "description": "`lookup_failed`"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Find somebody on another server",
        "tags": [
          "activitypub-service"
        ],
        "x-handler": "activitypub/cmd/api/handlers.(*Handlers).Lookup",
        "x-viewer": "signed_in"
      }
    },
    "/activitypub/posts/{id}/pictures": {
      "post": {
        "description": "The pictures of a post from another server that has been left alone a while are removed from storage, and the post says so (`media_removed`). Asked here, they are read again from where they came from. For anybody signed in who may see the post.\n\nWho may call it: somebody signed in.",
        "operationId": "postActivitypubPostsByIdPictures",
        "parameters": [
          {
            "description": "The post's id here.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PicturesRestored"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "description": "no token, or one that has expired"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            },
            "description": "`media_not_removed`: there is no such post the viewer may see, or its pictures are here"
          },
          "410": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            },
            "description": "`media_gone`"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            },
            "description": "`too_many_requests`"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            },
            "description": "`media_failed`"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Copy a post's pictures here again",
        "tags": [
          "activitypub-service"
        ],
        "x-handler": "activitypub/cmd/api/handlers.(*Handlers).RestorePictures",
        "x-viewer": "signed_in"
      }
    },
    "/activitypub/settings": {
      "get": {
        "description": "Who may call it: somebody signed in.",
        "operationId": "getActivitypubSettings",
        "parameters": [
          {
            "description": "The person's id. The viewer when left out.",
