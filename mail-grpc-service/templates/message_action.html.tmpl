{{define "body"}}
<!doctype html>
<html lang="en">
    <head>
        <meta name="viewport" content="width=device-width"/>
        <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
        <title>{{.title}}</title>
        <!--
            Styles are written here and inlined by premailer before sending.
            Gmail and Outlook both strip <style> blocks from the delivered
            message, so anything left in one is simply not applied.

            Deliberately plain: a table-based layout, web-safe fonts, no
            external images and no web fonts. Mail clients are not browsers,
            and the failure mode for cleverness here is a message that looks
            broken in exactly the client somebody reads their password reset in.
        -->
        <style type="text/css">
            body {
                margin: 0;
                padding: 0;
                background-color: #f4f4f5;
                font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
                color: #27272a;
            }
            .wrapper {
                width: 100%;
                background-color: #f4f4f5;
                padding: 24px 0;
            }
            .content {
                width: 100%;
                max-width: 560px;
                margin: 0 auto;
                background-color: #ffffff;
                border-radius: 8px;
                padding: 32px;
            }
            .header {
                margin: 0 0 24px 0;
                padding: 0 0 20px 0;
                border-bottom: 1px solid #e4e4e7;
            }
            .logo {
                display: block;
                max-height: 40px;
                max-width: 200px;
                border: 0;
            }
            .sitename {
                margin: 0;
                font-size: 15px;
                font-weight: 600;
                color: #52525b;
                letter-spacing: 0.01em;
            }
            .title {
                margin: 0 0 16px 0;
                font-size: 20px;
                line-height: 28px;
                font-weight: 600;
                color: #18181b;
            }
            /*
                A one-time code: the thing the message exists to deliver, so
                it gets a box of its own and the largest type on the page.
                Monospace with wide spacing, so six digits read as six digits
                and are hard to mistype. A table, because a bordered block is
                only dependable in mail clients as a table cell.
            */
            .code-box {
                margin: 0 0 24px 0;
                width: 100%;
            }
            .code {
                padding: 20px 16px;
                border: 2px solid #d4d4d8;
                border-radius: 8px;
                background-color: #fafafa;
                text-align: center;
                font-family: Menlo, Consolas, monospace;
                font-size: 40px;
                line-height: 48px;
                font-weight: 700;
                letter-spacing: 10px;
                color: #18181b;
            }
            .body {
                margin: 0 0 24px 0;
                font-size: 15px;
                line-height: 23px;
                color: #3f3f46;
            }
            .action {
                display: inline-block;
                padding: 12px 24px;
                background-color: #2563eb;
                color: #ffffff;
                font-size: 15px;
                font-weight: 600;
                text-decoration: none;
                border-radius: 6px;
            }
            .fallback {
                margin: 24px 0 0 0;
                font-size: 13px;
                line-height: 20px;
                color: #71717a;
                word-break: break-all;
            }
            .fallback a {
                color: #71717a;
            }
        </style>
    </head>
    <body>
        <table class="wrapper" role="presentation" cellpadding="0" cellspacing="0" border="0">
            <tr>
                <td align="center">
                    <table class="content" role="presentation" cellpadding="0" cellspacing="0" border="0">
                        <tr>
                            <td>
                                <!--
                                    The header degrades on purpose. Many clients
                                    block remote images until the reader asks for
                                    them, so the site name is TEXT beside the logo
                                    rather than being baked into it — a blocked
                                    image then costs the picture, not the identity
                                    of the sender.
                                -->
                                <div class="header">
                                    {{if .logoURL}}
                                    <img class="logo" src="{{.logoURL}}" alt="{{.siteName}}" />
                                    {{else}}
                                    <p class="sitename">{{.siteName}}</p>
                                    {{end}}
                                </div>
                                <h1 class="title">{{.title}}</h1>
                                {{if .code}}
                                <table class="code-box" role="presentation" cellpadding="0" cellspacing="0" border="0">
                                    <tr>
                                        <td class="code">{{.code}}</td>
                                    </tr>
                                </table>
                                {{end}}
                                <p class="body">{{.body}}</p>
                                {{if .actionURL}}
                                <p style="margin: 0;">
                                    <a class="action" href="{{.actionURL}}">{{.actionLabel}}</a>
                                </p>
                                <!--
                                    The same URL in text, because a button whose
                                    link cannot be copied is useless to anyone
                                    whose client blocks the anchor, and because
                                    people reasonably want to see where a link
                                    in a security email actually goes.
                                -->
                                <p class="fallback">
                                    If the button does not work, copy this link into your browser:<br/>
                                    <a href="{{.actionURL}}">{{.actionURL}}</a>
                                </p>
                                {{end}}
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </body>
</html>
{{end}}
